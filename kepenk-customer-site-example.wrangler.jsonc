{
  "name": "kepenk-customer-sites",
  "compatibility_date": "2026-10-10",
  "main": "./external/kepenk/static-assets-worker.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
