{
  "name": "yzt-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --project=mobile-small --project=mobile-large",
    "cloudflare:check": "npx vinext check",
    "cloudflare:init": "npx vinext init",
    "cloudflare:deploy": "npx @vinext/cloudflare deploy",
    "cloudflare:dry-run": "npx @vinext/cloudflare deploy --dry-run",
    "cloudflare:preview": "npx @vinext/cloudflare deploy --preview"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "next": "16.3.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
