{
  "name": "yzt-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --project=mobile-small --project=mobile-large",
    "cloudflare:check": "vinext check",
    "cloudflare:init": "vinext init --platform=cloudflare",
    "cloudflare:deploy": "npx @vinext/cloudflare deploy",
    "cloudflare:dry-run": "npx @vinext/cloudflare deploy --dry-run",
    "cloudflare:preview": "npx @vinext/cloudflare deploy --preview",
    "dev:vinext": "vinext dev",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "next": "16.3.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vinext": "1.0.0-beta.11",
    "vite": "8.3.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@cloudflare/vite-plugin": "1.59.0",
    "wrangler": "4.138.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@11"
}
